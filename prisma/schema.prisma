generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  role      UserRole
  student   Student?
  teacher   Teacher?

  posts Post[]
  replies Reply[]
  @@map("users")
}

model Student {
  id          Int                  @id @default(autoincrement())
  userId      Int                  @unique
  deliveries  AssignmentDelivery[] 
  enrollments Enrollment[]
  user        User                 @relation(fields: [userId], references: [id])

  @@map("students")
}

model Teacher {
  id      Int     @id @default(autoincrement())
  userId  Int     @unique
  classes Class[]
  user    User    @relation(fields: [userId], references: [id])

  @@map("teachers")
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  name     String
  domainId Int
  domain   Domain @relation(fields: [domainId], references: [id])

  @@map("admins")
}

model Domain {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  admins Admin[]

  @@map("domains")
}

model Class {
  id          Int          @id @default(autoincrement())
  name        String
  code        String       @unique
  createdAt   DateTime     @default(now())
  teacherId   Int

  teacher     Teacher      @relation(fields: [teacherId], references: [id])

  posts       Post[]
  assignments Assignment[]
  enrollments Enrollment[]

  @@map("classes")
}

model Enrollment {
  id        Int     @id @default(autoincrement())
  studentId Int
  classId   Int

  class     Class   @relation(fields: [classId], references: [id])
  student   Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, classId])
  @@map("enrollments")
}

model Assignment {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  startDate   DateTime
  dueDate     DateTime
  classId     Int

  class       Class                @relation(fields: [classId], references: [id])
  deliveries  AssignmentDelivery[]
  files       AssignmentFile[]

  @@map("assignments")
}

model AssignmentFile {
  id           Int        @id @default(autoincrement())
  assignmentId Int
  fileKey      String
  fileName     String

  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)   

  @@map("assignment_files")
}

model AssignmentDelivery {
  id           Int        @id @default(autoincrement())
  submittedAt  DateTime?  @default(now())
  studentId    Int
  assignmentId Int
  delivered    Boolean
  score        Float
  
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id])

  deliveryFiles DeliveryFile[]
  
  @@unique([assignmentId, studentId])
  @@map("assignments_deliveries")
}

model DeliveryFile {
  id           Int                       @id @default(autoincrement())
  deliveryId   Int
  fileKey      String                    @default("")
  fileName     String                    @default("")

  assignmentDelivery AssignmentDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("delivery_files")
}

model Post {
  id            Int @id @default(autoincrement())
  createdAt     DateTime @default(now())
  text          String
  userId        Int
  classId       Int
  
  class         Class @relation(fields: [classId], references: [id])
  user          User @relation(fields: [userId], references: [id])

  replies       Reply[]
  @@map("posts")
}

model Reply {
  id             Int @id @default(autoincrement())
  text           String
  submittedAt    DateTime @default(now())
  userId         Int 
  postId         Int

  user           User @relation(fields: [userId], references: [id])
  post           Post @relation(fields: [postId], references: [id])


  @@map("replies")
}